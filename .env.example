# ===== LLM 容灾链：按顺序尝试，任何一个可用即可 =====
# 1) 主 Provider（DeepSeek，当前余额不足未启用；充值后填回即可自动恢复首选）
# SSRM_AIOPS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
SSRM_AIOPS_LLM_BASE_URL=https://api.deepseek.com
SSRM_AIOPS_LLM_MODEL=deepseek-chat

# 2) 智谱（glm-4-flash 永久免费）
SSRM_AIOPS_ZHIPU_API_KEY=<在此填你的智谱 Key，形如 id.secret>

# 3) 硅基流动（Qwen2.5-7B-Instruct 免费档）
SSRM_AIOPS_SILICONFLOW_API_KEY=

# ===== OTel 协议出口（T2-07）：默认关闭，本地没有 collector 时不要开 =====
# 打开后按 OTLP/HTTP + JSON 把 span 推到 endpoint（collector 标准端口 4318），
# 同时在响应头回写 W3C traceparent。验证可见 GET /otel/stats。
# SSRM_AIOPS_OTEL_ENABLED=true
# SSRM_AIOPS_OTEL_ENDPOINT=http://127.0.0.1:4318
# SSRM_AIOPS_OTEL_SERVICE_NAME=ssrm-aiops

# ===== Trace 落库（T2-05）=====
# 保留期按天算，清理按写入次数摊薄（每 500 次写清一次）
# SSRM_AIOPS_TRACE_RETENTION_DAYS=7
